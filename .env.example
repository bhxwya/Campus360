# =============================================================================
# Campus360 - environment configuration TEMPLATE
# =============================================================================
# How to use:
#   1. Copy this file to a new file named `.env` (same folder, next to it):
#        Copy-Item .env.example .env
#   2. Replace every CHANGE_ME value with your real local configuration.
#   3. `.env` is listed in .gitignore and must NEVER be committed.
#
# Every variable uses the CAMPUS360_ prefix; backend/app/core/config.py maps
# them onto the Settings class (CAMPUS360_DB_HOST -> Settings.db_host).
# =============================================================================

# --- Application ------------------------------------------------------------
# development | test | production
CAMPUS360_ENVIRONMENT=development
CAMPUS360_APP_NAME=Campus360 API

# --- PostgreSQL connection --------------------------------------------------
# Component-wise on purpose: the backend builds a properly URL-encoded
# Psycopg connection string from these, so special characters in the password
# cannot break the URL. Do NOT paste a full connection string here.
CAMPUS360_DB_HOST=localhost
CAMPUS360_DB_PORT=5432
CAMPUS360_DB_NAME=campus360_db
CAMPUS360_DB_USER=campus360_user
CAMPUS360_DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Database used by pytest. Create it as a SEPARATE database so tests can never
# touch development data.
CAMPUS360_TEST_DB_NAME=campus360_test

# --- Authentication (session signing key, used from Stage 3) ---------------
# Generate a fresh value for local development with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. Rotating it invalidates existing sessions.
CAMPUS360_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_VALUE

# Cookie hardening: keep false for plain-HTTP local development; set to true
# when the app is served over HTTPS in production (Secure + SameSite flags).
CAMPUS360_COOKIE_SECURE=false
# Session lifetime in seconds (default 8 hours).
CAMPUS360_SESSION_MAX_AGE_SECONDS=28800

# --- CORS -------------------------------------------------------------------
# Origins allowed to call the API WITH credentials when the frontend runs on a
# DIFFERENT origin (e.g. VS Code Live Server). JSON array format. The default
# dev workflow serves the frontend from the same origin as the API, in which
# case these are simply unused. In production, list only your real frontend URL.
CAMPUS360_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
